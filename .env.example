# ─────────────────────────────────────────────────────────────────────────────
# Lumina — environment variable reference
# Copy to .env.local and fill in your values.
# ─────────────────────────────────────────────────────────────────────────────

# ── App ───────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://user:password@localhost:5432/lumina

# ── Auth (Better Auth) ────────────────────────────────────────────────────────
BETTER_AUTH_SECRET=your-secret-at-least-32-chars
BETTER_AUTH_URL=http://localhost:3000
NEXT_PUBLIC_BETTER_AUTH_URL=http://localhost:3000

# ── Google Calendar OAuth ─────────────────────────────────────────────────────
# Create at https://console.cloud.google.com → APIs & Services → Credentials
# Scopes: https://www.googleapis.com/auth/calendar.readonly
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Secondary OAuth client used specifically for Calendar API (if separate app)
GOOGLE_CLIENT_ID_CALENDAR=
GOOGLE_CLIENT_SECRET_CALENDAR=

# ── Microsoft / Outlook OAuth ─────────────────────────────────────────────────
# Register at https://portal.azure.com → App registrations
# Scopes: Calendars.Read offline_access
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=

# ── AI (Gemini) ───────────────────────────────────────────────────────────────
# Get your key at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# Optional. Overrides the Gemini model without a deploy.
# `gemini-2.0-flash` was hardcoded in four routes and retired by Google, taking
# the daily brief, docs AI, goal suggestions and event parsing down together.
# Model names are upstream data on someone else's schedule — when the next one
# is retired, set this rather than waiting on a release.
# GEMINI_MODEL=gemini-3.6-flash

# ── Web Push Notifications ────────────────────────────────────────────────────
# Generate with: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# ── Cron jobs ─────────────────────────────────────────────────────────────────
# Secret header value required by /api/cron/* endpoints
CRON_SECRET=

# ── SEO / Verification (optional) ─────────────────────────────────────────────
NEXT_PUBLIC_GSC_VERIFICATION=
NEXT_PUBLIC_BING_VERIFICATION=
