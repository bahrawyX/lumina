# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/playwright-report
/playwright-screenshots
/test-results
/playwright/.cache

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

.vercel

.vercel
.env*.local

# P3-8: generated logs were committed at the repo root. The rules above only
# cover the package-manager debug logs; a `> tsc.log` or a Playwright run
# produced files nothing ignored.
*.log

# Claude Code scratch worktrees — full checkouts (~2.9 GB), each its own git
# repo. Committing them would nest repositories inside this one, and they were
# already polluting `eslint .` with 53,743 problems before the eslint ignore.
.claude/worktrees/

# Excalidraw fonts, copied out of node_modules by scripts/copy-excalidraw-assets.mjs
# on postinstall. Generated, 14MB, and reproducible — committing it would put a
# vendored copy of a dependency in the repo that silently goes stale.
/public/excalidraw/
